<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <AssemblyName>CosmicSandbox</AssemblyName>
    <Authors>Cosmic Sandbox Team</Authors>
    <Company>Cosmic Sandbox</Company>
    <Product>Cosmic Sandbox</Product>
    <Description>Production-ready Windows 11 gravitational simulator with 3D visualization</Description>
    <Version>1.0.0</Version>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CosmicSandbox.Core\CosmicSandbox.Core.csproj" />
    <ProjectReference Include="..\CosmicSandbox.PhysicsEngine\CosmicSandbox.PhysicsEngine.csproj" />
    <ProjectReference Include="..\CosmicSandbox.Renderer\CosmicSandbox.Renderer.csproj" />
    <ProjectReference Include="..\CosmicSandbox.AssetPipeline\CosmicSandbox.AssetPipeline.csproj" />
    <ProjectReference Include="..\CosmicSandbox.Serialization\CosmicSandbox.Serialization.csproj" />
    <ProjectReference Include="..\CosmicSandbox.Diagnostics\CosmicSandbox.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
