<Window x:Class="CosmicSandbox.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="Cosmic Sandbox - Gravitational Simulator"
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                <MenuItem Header="Save _As..." Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xport">
                    <MenuItem Header="Export _Image..." Click="ExportImage_Click"/>
                    <MenuItem Header="Export _Video..." Click="ExportVideo_Click"/>
                    <MenuItem Header="Export _Data (CSV)..." Click="ExportData_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Preferences..." Click="Preferences_Click"/>
            </MenuItem>
            <MenuItem Header="_Simulation">
                <MenuItem Header="_Play/Pause" InputGestureText="Space" Click="ToggleSimulation_Click"/>
                <MenuItem Header="_Reset" Click="ResetSimulation_Click"/>
                <Separator/>
                <MenuItem Header="_Add Body..." Click="AddBody_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" Click="Documentation_Click"/>
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Object Library -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Object Library" Margin="10"
                               FontSize="16" FontWeight="SemiBold"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Presets" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Button Content="Solar System" Margin="0,2" Click="LoadSolarSystem_Click"/>
                            <Button Content="Binary Stars" Margin="0,2" Click="LoadBinaryStars_Click"/>
                            <Button Content="Three-Body Problem" Margin="0,2" Click="LoadThreeBody_Click"/>
                            <Button Content="Galaxy Collision" Margin="0,2" Click="LoadGalaxyCollision_Click"/>

                            <TextBlock Text="Quick Add" FontWeight="SemiBold" Margin="0,20,0,5"/>
                            <Button Content="+ Star" Margin="0,2" Click="AddStar_Click"/>
                            <Button Content="+ Planet" Margin="0,2" Click="AddPlanet_Click"/>
                            <Button Content="+ Moon" Margin="0,2" Click="AddMoon_Click"/>
                            <Button Content="+ Asteroid" Margin="0,2" Click="AddAsteroid_Click"/>

                            <TextBlock Text="Current Bodies" FontWeight="SemiBold" Margin="0,20,0,5"/>
                            <ListBox x:Name="BodiesListBox" Height="300"
                                     SelectionChanged="BodiesListBox_SelectionChanged"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Center - 3D Viewport -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Height="40">
                    <Button Content="▶" Width="40" Margin="5" Click="ToggleSimulation_Click" ToolTip="Play/Pause (Space)"/>
                    <Button Content="⏹" Width="40" Margin="5" Click="ResetSimulation_Click" ToolTip="Reset"/>
                    <Separator Width="1" Margin="5,0"/>
                    <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <Slider x:Name="TimeScaleSlider" Width="150" Minimum="0.1" Maximum="1000"
                            Value="1" VerticalAlignment="Center" ToolTip="Time Scale"/>
                    <TextBlock x:Name="TimeScaleText" Text="1.0x" VerticalAlignment="Center" Margin="5,0,0,0" Width="60"/>
                </StackPanel>

                <!-- 3D Viewport -->
                <Border Grid.Row="1" Background="Black">
                    <Grid>
                        <!-- DirectX rendering surface will be hosted here -->
                        <Border x:Name="RenderHost" Background="Black"/>

                        <!-- Overlay Info -->
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Margin="10" Background="#80000000">
                            <TextBlock x:Name="FpsText" Text="FPS: 60" Foreground="White" Margin="5"/>
                            <TextBlock x:Name="BodyCountText" Text="Bodies: 0" Foreground="White" Margin="5"/>
                            <TextBlock x:Name="SimTimeText" Text="Time: 0.0s" Foreground="White" Margin="5"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Panel - Inspector -->
            <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Inspector" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Expander Header="Physical Properties" IsExpanded="True">
                            <StackPanel Margin="10,5">
                                <TextBlock Text="Name:"/>
                                <TextBox x:Name="NameTextBox" Margin="0,2,0,10"/>

                                <TextBlock Text="Mass (kg):"/>
                                <TextBox x:Name="MassTextBox" Margin="0,2,0,10"/>

                                <TextBlock Text="Radius (m):"/>
                                <TextBox x:Name="RadiusTextBox" Margin="0,2,0,10"/>

                                <TextBlock Text="Type:"/>
                                <ComboBox x:Name="TypeComboBox" Margin="0,2,0,10"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Position & Velocity" Margin="0,5,0,0">
                            <StackPanel Margin="10,5">
                                <TextBlock Text="Position (m):"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PosXTextBox" Grid.Column="0" Margin="0,2,2,0" PlaceholderText="X"/>
                                    <TextBox x:Name="PosYTextBox" Grid.Column="1" Margin="2,2,2,0" PlaceholderText="Y"/>
                                    <TextBox x:Name="PosZTextBox" Grid.Column="2" Margin="2,2,0,0" PlaceholderText="Z"/>
                                </Grid>

                                <TextBlock Text="Velocity (m/s):" Margin="0,10,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="VelXTextBox" Grid.Column="0" Margin="0,2,2,0" PlaceholderText="X"/>
                                    <TextBox x:Name="VelYTextBox" Grid.Column="1" Margin="2,2,2,0" PlaceholderText="Y"/>
                                    <TextBox x:Name="VelZTextBox" Grid.Column="2" Margin="2,2,0,0" PlaceholderText="Z"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Visual Properties" Margin="0,5,0,0">
                            <StackPanel Margin="10,5">
                                <TextBlock Text="Texture:"/>
                                <Button Content="Browse..." Click="BrowseTexture_Click" Margin="0,2,0,10"/>

                                <CheckBox x:Name="EmissiveCheckBox" Content="Emissive (Star)" Margin="0,5"/>
                                <CheckBox x:Name="AtmosphereCheckBox" Content="Has Atmosphere" Margin="0,5"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Simulation Settings" Margin="0,5,0,0">
                            <StackPanel Margin="10,5">
                                <TextBlock Text="Integrator:"/>
                                <ComboBox x:Name="IntegratorComboBox" Margin="0,2,0,10"/>

                                <TextBlock Text="Timestep (s):"/>
                                <TextBox x:Name="TimestepTextBox" Margin="0,2,0,10"/>

                                <CheckBox x:Name="CollisionsCheckBox" Content="Enable Collisions" Margin="0,5"/>

                                <TextBlock Text="Energy Drift:"/>
                                <TextBlock x:Name="EnergyDriftText" Text="0.00%" Margin="0,2,0,10"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
